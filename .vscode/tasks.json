{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Active Plugin",
            "type": "shell",
            "command": "${workspaceFolder}/compile.sh",
            "args": [
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "sourcepawn",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\)\\s*:\\s*(error|warning)\\s*(\\d+):\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Compile All Plugins",
            "type": "shell",
            "command": "${workspaceFolder}/compile.sh",
            "args": [],
            "group": "build",
            "problemMatcher": {
                "owner": "sourcepawn",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.*)\\((\\d+)\\)\\s*:\\s*(error|warning)\\s*(\\d+):\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
